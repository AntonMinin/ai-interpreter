---
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client'
import { ISSUES, RELEASES, type Locale } from '../i18n/ui'
import { localePath, useTranslations } from '../i18n/utils'
import CostEstimator from './CostEstimator.tsx'
import FeedbackForm from './FeedbackForm.tsx'
import Flow from './Flow.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

const steps = [1, 2, 3, 4] as const
const features = [1, 2, 3, 4, 5, 6] as const
const limits = [1, 2, 3, 4] as const
const faqs = [1, 2, 3, 4, 5, 6, 7, 8] as const
const privacyPoints = [1, 2, 3, 4] as const
const examples = [1, 2, 3, 4] as const

// Cloudflare's documented always-passes test key, so the form is usable in
// local development before real keys exist. Production must set the real one.
const TURNSTILE_TEST_KEY = '1x00000000000000000000AA'
const siteKey = PUBLIC_TURNSTILE_SITE_KEY || TURNSTILE_TEST_KEY

const feedbackLabels = {
  kind: t('fb.kind'),
  kindQuestion: t('fb.kindQuestion'),
  kindSuggestion: t('fb.kindSuggestion'),
  kindBug: t('fb.kindBug'),
  message: t('fb.message'),
  messagePlaceholder: t('fb.messagePlaceholder'),
  contact: t('fb.contact'),
  contactHint: t('fb.contactHint'),
  submit: t('fb.submit'),
  sending: t('fb.sending'),
  sentTitle: t('fb.sentTitle'),
  sentBody: t('fb.sentBody'),
  sendAnother: t('fb.sendAnother'),
  captchaPending: t('fb.captchaPending'),
  counter: t('fb.counter'),
  errRateLimited: t('fb.errRateLimited'),
  errCaptcha: t('fb.errCaptcha'),
  errTooShort: t('fb.errTooShort'),
  errTooLong: t('fb.errTooLong'),
  errServer: t('fb.errServer'),
  errNetwork: t('fb.errNetwork'),
  privacyNote: t('fb.privacyNote')
}

const featureIcons: Record<number, string> = {
  1: 'M8 12h8M12 8v8',
  2: 'M4 7h16M4 12h10M4 17h13',
  3: 'M12 4l7 4v5c0 4-3 6.5-7 8-4-1.5-7-4-7-8V8z',
  4: 'M7 11V8a5 5 0 0110 0v3M5 11h14v9H5z',
  5: 'M12 4v9m0 0a3 3 0 003-3V7a3 3 0 10-6 0v3a3 3 0 003 3zm-6 3a6 6 0 0012 0M9 20h6',
  6: 'M5 6h14v10H5zM9 20h6M8 10h3M8 13h6'
}
---

<section class="relative overflow-hidden border-b border-edge">
  <div
    class="pointer-events-none absolute inset-0 opacity-70"
    style="background:radial-gradient(60% 55% at 50% -5%, rgba(53,194,110,.16), transparent 70%)"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-4 pb-20 pt-16 sm:px-6 sm:pt-24">
    <span
      class="inline-flex items-center gap-2 rounded-full border border-warn/40 bg-warn/10 px-3 py-1 text-xs font-medium text-warn"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-warn"></span>
      {t('hero.badge')}
    </span>

    <h1 class="mt-6 max-w-3xl text-4xl font-semibold leading-[1.1] tracking-tight sm:text-6xl">
      {t('hero.title')}<br /><span class="text-accent">{t('hero.titleAccent')}</span>
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-fg/80">{t('hero.lead')}</p>

    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a
        href={RELEASES}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-xl border border-accent bg-accent-dim px-6 py-3 font-semibold text-white transition-colors hover:bg-accent hover:text-ink"
      >
        {t('hero.ctaPrimary')}
      </a>
      <a
        href={localePath(locale, 'docs/install')}
        class="rounded-xl border border-edge bg-panel px-6 py-3 font-semibold transition-colors hover:border-muted"
      >
        {t('hero.ctaSecondary')}
      </a>
    </div>

    <p class="mt-6 text-sm text-muted">{t('hero.note')}</p>
  </div>
</section>

<Flow locale={locale} />

<section class="border-y border-edge bg-panel/30">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{t('steps.title')}</h2>
    <ol class="mt-10 grid gap-6 md:grid-cols-2">
      {
        steps.map((n) => (
          <li class="rounded-2xl border border-edge bg-panel p-6">
            <div
              class="flex h-9 w-9 items-center justify-center rounded-lg border border-accent/40 bg-accent-dim/20 font-mono font-semibold text-accent"
              aria-hidden="true"
            >
              {n}
            </div>
            <h3 class="mt-4 font-semibold">{t(`steps.${n}.title` as never)}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{t(`steps.${n}.body` as never)}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{t('features.title')}</h2>
  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((n) => (
        <div class="rounded-2xl border border-edge bg-panel p-6">
          <svg
            viewBox="0 0 24 24"
            class="h-6 w-6 text-accent"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={featureIcons[n]} />
          </svg>
          <h3 class="mt-4 font-semibold">{t(`features.${n}.title` as never)}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{t(`features.${n}.body` as never)}</p>
        </div>
      ))
    }
  </div>
</section>

<section class="border-y border-edge bg-panel/30" id="cost">
  <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6">
    <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{t('cost.title')}</h2>
    <p class="mt-3 text-muted">{t('cost.lead')}</p>

    <div class="mt-8">
      <CostEstimator
        locale={locale}
        minutesLabel={t('cost.minutes')}
        directionLabel={t('cost.direction')}
        resultLabel={t('cost.result')}
        perMeetingLabel={t('cost.perMeeting')}
        disclaimer={t('cost.disclaimer')}
        client:visible
      />
    </div>

    <div class="mt-6 rounded-2xl border border-accent/30 bg-accent-dim/10 p-6">
      <h3 class="font-semibold text-accent">{t('cost.noKeyTitle')}</h3>
      <p class="mt-2 text-sm leading-relaxed text-fg/85">{t('cost.noKeyBody')}</p>
    </div>
  </div>
</section>

<section class="mx-auto max-w-4xl px-4 py-20 sm:px-6">
  <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{t('privacy.title')}</h2>
  <p class="mt-3 text-muted">{t('privacy.lead')}</p>
  <ul class="mt-8 space-y-3">
    {
      privacyPoints.map((n) => (
        <li class="flex gap-3 rounded-xl border border-edge bg-panel px-5 py-4">
          <svg
            viewBox="0 0 24 24"
            class="mt-0.5 h-5 w-5 shrink-0 text-accent"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="text-sm leading-relaxed text-fg/85">{t(`privacy.${n}` as never)}</span>
        </li>
      ))
    }
  </ul>
  <p class="mt-6 text-sm leading-relaxed text-muted">{t('privacy.foot')}</p>
  <a
    href={localePath(locale, 'docs/privacy')}
    class="mt-4 inline-block text-sm font-semibold text-accent underline decoration-1 underline-offset-4 hover:text-fg"
  >
    {t('privacy.link')} →
  </a>
</section>

<section class="border-y border-edge bg-panel/30">
  <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6">
    <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{t('limits.title')}</h2>
    <p class="mt-3 text-muted">{t('limits.lead')}</p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {
        limits.map((n) => (
          <div class="rounded-xl border border-warn/30 bg-warn/5 p-5">
            <h3 class="text-sm font-semibold text-warn">{t(`limits.${n}.title` as never)}</h3>
            <p class="mt-2 text-sm leading-relaxed text-fg/80">{t(`limits.${n}.body` as never)}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="mx-auto max-w-3xl px-4 py-20 sm:px-6" id="faq">
  <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{t('faq.title')}</h2>
  <div class="mt-8 divide-y divide-edge overflow-hidden rounded-2xl border border-edge bg-panel">
    {
      faqs.map((n) => (
        <details class="group">
          <summary
            class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-medium transition-colors hover:text-accent"
          >
            <span>{t(`faq.q${n}` as never)}</span>
            <svg
              viewBox="0 0 24 24"
              class="h-5 w-5 shrink-0 text-muted transition-transform group-open:rotate-45"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M12 5v14M5 12h14" stroke-linecap="round" />
            </svg>
          </summary>
          <p class="px-6 pb-6 text-sm leading-relaxed text-muted">{t(`faq.a${n}` as never)}</p>
        </details>
      ))
    }
  </div>
</section>

<section class="border-t border-edge bg-panel/30" id="feedback">
  <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6">
    <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{t('fb.title')}</h2>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted">{t('fb.lead')}</p>

    <div class="mt-10">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-muted">
        {t('fb.examplesTitle')}
      </h3>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          examples.map((n) => (
            <li class="rounded-xl border border-edge bg-panel-2/60 p-4">
              <span class="text-xs font-semibold uppercase tracking-wider text-accent">
                {t(`fb.ex${n}.kind` as never)}
              </span>
              <p class="mt-2 text-sm leading-relaxed text-fg/80">“{t(`fb.ex${n}.text` as never)}”</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-8">
      <FeedbackForm locale={locale} siteKey={siteKey} labels={feedbackLabels} client:visible />
    </div>

    <div class="mt-6 rounded-xl border border-edge bg-panel px-6 py-5">
      <h3 class="text-sm font-semibold">{t('fb.altTitle')}</h3>
      <p class="mt-1.5 text-sm leading-relaxed text-muted">{t('fb.altBody')}</p>
      <a
        href={ISSUES}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-block text-sm font-semibold text-accent underline decoration-1 underline-offset-4 hover:text-fg"
      >
        {t('fb.altLink')} →
      </a>
    </div>
  </div>
</section>

<section class="border-t border-edge bg-panel/40">
  <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6">
    <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{t('cta.title')}</h2>
    <p class="mx-auto mt-4 max-w-xl leading-relaxed text-muted">{t('cta.body')}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href={RELEASES}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-xl border border-accent bg-accent-dim px-6 py-3 font-semibold text-white transition-colors hover:bg-accent hover:text-ink"
      >
        {t('cta.download')}
      </a>
      <a
        href={ISSUES}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-xl border border-edge bg-panel px-6 py-3 font-semibold transition-colors hover:border-muted"
      >
        {t('cta.issues')}
      </a>
    </div>
  </div>
</section>
