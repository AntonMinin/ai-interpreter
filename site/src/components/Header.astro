---
import { GITHUB, RELEASES, type Locale } from '../i18n/ui'
import { localePath, useTranslations } from '../i18n/utils'
import LangSwitch from './LangSwitch.astro'
import MobileNav from './MobileNav.tsx'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

const links = [
  { href: localePath(locale), label: t('nav.home') },
  { href: localePath(locale, 'docs/install'), label: t('nav.docs') },
  { href: `${localePath(locale)}#feedback`, label: t('nav.feedback') },
  { href: GITHUB, label: t('nav.github'), external: true }
]
const current = Astro.url.pathname
---

<header
  class="sticky top-0 z-40 border-b border-edge/70 bg-ink/85 backdrop-blur supports-[backdrop-filter]:bg-ink/70"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 sm:px-6">
    <a
      href={localePath(locale)}
      class="flex items-center gap-2.5 font-semibold tracking-tight transition-opacity hover:opacity-80"
    >
      <svg viewBox="0 0 32 32" class="h-7 w-7 shrink-0" aria-hidden="true">
        <rect width="32" height="32" rx="7" fill="#141a21"></rect>
        <path
          d="M9 11v10M13 8v16M17 12v8M21 9.5v13M25 13v6"
          stroke="#35c26e"
          stroke-width="2.4"
          stroke-linecap="round"></path>
      </svg>
      <span>AI Interpreter</span>
    </a>

    <nav class="ml-auto hidden items-center gap-1 md:flex" aria-label={t('a11y.mainNav')}>
      {
        links.map((link) => (
          <a
            href={link.href}
            rel={link.external ? 'noopener noreferrer' : undefined}
            target={link.external ? '_blank' : undefined}
            aria-current={!link.external && current === link.href ? 'page' : undefined}
            class="rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:bg-panel-2 hover:text-fg aria-[current=page]:text-fg"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 md:ml-0">
      <LangSwitch locale={locale} />
      <a
        href={RELEASES}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-lg border border-accent bg-accent-dim px-3.5 py-2 text-sm font-semibold text-white transition-colors hover:bg-accent hover:text-ink sm:inline-block"
      >
        {t('nav.download')}
      </a>
      <MobileNav
        links={links}
        openLabel={t('nav.menu')}
        closeLabel={t('nav.close')}
        downloadLabel={t('nav.download')}
        downloadHref={RELEASES}
        client:load
      />
    </div>
  </div>
</header>
