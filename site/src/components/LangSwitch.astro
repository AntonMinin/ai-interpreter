---
import { locales, localeNames, type Locale } from '../i18n/ui'
import { switchLocalePath, useTranslations } from '../i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)
---

<div
  class="flex items-center rounded-lg border border-edge p-0.5"
  role="group"
  aria-label={t('a11y.langSwitch')}
>
  {
    locales.map((alt) => (
      <a
        href={switchLocalePath(Astro.url, alt)}
        hreflang={alt}
        lang={alt}
        aria-current={alt === locale ? 'true' : undefined}
        class:list={[
          'rounded-md px-2.5 py-1 text-xs font-semibold uppercase tracking-wide transition-colors',
          alt === locale ? 'bg-panel-2 text-fg' : 'text-muted hover:text-fg'
        ]}
      >
        <span class="sr-only">{localeNames[alt]}</span>
        <span aria-hidden="true">{alt}</span>
      </a>
    ))
  }
</div>
