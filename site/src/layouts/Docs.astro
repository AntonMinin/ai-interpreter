---
import type { MarkdownHeading } from 'astro'
import Base from './Base.astro'
import { GITHUB, ui, type Locale } from '../i18n/ui'
import { localePath, useTranslations } from '../i18n/utils'

interface NavEntry {
  slug: string
  title: string
  section: 'start' | 'use' | 'about'
}

interface Props {
  locale: Locale
  title: string
  description: string
  headings: MarkdownHeading[]
  nav: NavEntry[]
  slug: string
}

const { locale, title, description, headings, nav, slug } = Astro.props
const t = useTranslations(locale)

const sections = [
  { id: 'start', label: t('docs.sectionStart') },
  { id: 'use', label: t('docs.sectionUse') },
  { id: 'about', label: t('docs.sectionAbout') }
] as const

const index = nav.findIndex((entry) => entry.slug === slug)
const prev = index > 0 ? nav[index - 1] : undefined
const next = index >= 0 && index < nav.length - 1 ? nav[index + 1] : undefined
const toc = headings.filter((heading) => heading.depth === 2)
---

<Base locale={locale} title={`${title} — ${ui[locale]['docs.title']}`} description={description}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="lg:grid lg:grid-cols-[15rem_minmax(0,1fr)_13rem] lg:gap-10">
      <aside class="hidden lg:block">
        <nav
          class="sticky top-16 max-h-[calc(100dvh-4rem)] overflow-y-auto py-10 pr-2"
          aria-label={t('a11y.docsNav')}
        >
          {
            sections.map((section) => {
              const entries = nav.filter((entry) => entry.section === section.id)
              if (entries.length === 0) return null
              return (
                <div class="mb-7">
                  <h2 class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted">
                    {section.label}
                  </h2>
                  <ul class="space-y-0.5 border-l border-edge">
                    {entries.map((entry) => (
                      <li>
                        <a
                          href={localePath(locale, `docs/${entry.slug}`)}
                          aria-current={entry.slug === slug ? 'page' : undefined}
                          class="-ml-px block border-l border-transparent py-1.5 pl-4 text-sm text-muted transition-colors hover:border-muted hover:text-fg aria-[current=page]:border-accent aria-[current=page]:font-medium aria-[current=page]:text-accent"
                        >
                          {entry.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            })
          }
        </nav>
      </aside>

      <article class="min-w-0 py-10 lg:py-14">
        <p class="text-xs font-semibold uppercase tracking-wider text-accent">{t('docs.title')}</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
        <p class="mt-4 text-lg leading-relaxed text-muted">{description}</p>

        <div class="mt-10 border-t border-edge pt-10">
          <div class="prose-doc">
            <slot />
          </div>
        </div>

        <nav class="mt-14 grid gap-4 border-t border-edge pt-8 sm:grid-cols-2">
          {
            prev ? (
              <a
                href={localePath(locale, `docs/${prev.slug}`)}
                class="rounded-xl border border-edge bg-panel px-5 py-4 transition-colors hover:border-muted"
              >
                <div class="text-xs uppercase tracking-wider text-muted">{t('docs.prev')}</div>
                <div class="mt-1 font-medium">{prev.title}</div>
              </a>
            ) : (
              <div class="hidden sm:block" />
            )
          }
          {
            next && (
              <a
                href={localePath(locale, `docs/${next.slug}`)}
                class="rounded-xl border border-edge bg-panel px-5 py-4 text-right transition-colors hover:border-muted sm:col-start-2"
              >
                <div class="text-xs uppercase tracking-wider text-muted">{t('docs.next')}</div>
                <div class="mt-1 font-medium">{next.title}</div>
              </a>
            )
          }
        </nav>

        <p class="mt-8 text-sm text-muted">
          {t('docs.editNote')}{' '}
          <a
            href={`${localePath(locale)}#feedback`}
            class="font-medium text-accent underline decoration-1 underline-offset-4 hover:text-fg"
          >
            {t('docs.editLink')}
          </a>{' '}
          <span class="text-muted/70">·</span>{' '}
          <a
            href={`${GITHUB}/issues`}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-accent underline decoration-1 underline-offset-4 hover:text-fg"
          >
            GitHub
          </a>
        </p>
      </article>

      <aside class="hidden xl:block">
        {
          toc.length > 1 && (
            <nav class="sticky top-16 max-h-[calc(100dvh-4rem)] overflow-y-auto py-14">
              <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted">
                {t('docs.onThisPage')}
              </h2>
              <ul class="space-y-2 border-l border-edge">
                {toc.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class="-ml-px block border-l border-transparent pl-4 text-sm leading-snug text-muted transition-colors hover:border-muted hover:text-fg"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </aside>
    </div>
  </div>
</Base>
