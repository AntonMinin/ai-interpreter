---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { locales, ui, type Locale } from '../i18n/ui'
import { localePath, switchLocalePath, useTranslations } from '../i18n/utils'

interface Props {
  locale: Locale
  title: string
  description: string
}

const { locale, title, description } = Astro.props
const t = useTranslations(locale)
const canonical = new URL(Astro.url.pathname, Astro.site).href
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0c1014" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="generator" content={Astro.generator} />

    {
      locales.map((alt) => (
        <link
          rel="alternate"
          hreflang={alt}
          href={new URL(switchLocalePath(Astro.url, alt), Astro.site).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(switchLocalePath(Astro.url, 'en'), Astro.site).href}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta name="twitter:card" content="summary" />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230c1014'/%3E%3Cpath d='M9 11v10M13 8v16M17 12v8M21 9.5v13M25 13v6' stroke='%2335c26e' stroke-width='2.4' stroke-linecap='round'/%3E%3C/svg%3E"
    />
  </head>

  <body class="min-h-dvh flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:font-semibold focus:text-ink"
    >
      {t('nav.skip')}
    </a>

    <Header locale={locale} />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer locale={locale} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'AI Interpreter',
        applicationCategory: 'CommunicationApplication',
        operatingSystem: 'Windows',
        description: ui[locale]['meta.description'],
        url: new URL(localePath(locale), Astro.site).href,
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
      })}
    />
  </body>
</html>
