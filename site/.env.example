# Copy to .env for local development. On Vercel these go in
# Settings -> Environment Variables. Never commit real values.
#
# These four are declared as a typed schema in astro.config.mjs (env.schema)
# and read via astro:env. The three secrets are read at runtime, so rotating
# one in the Vercel dashboard applies without a redeploy.

# Cloudflare Turnstile — dash.cloudflare.com -> Turnstile -> Add site.
# The site key is public and ends up in the HTML; that is expected.
# Left empty, Turnstile falls back to Cloudflare's always-passes test pair,
# but only in `astro dev`. Production refuses to send without the real secret.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Telegram delivery.
# 1. Message @BotFather -> /newbot -> copy the token here.
# 2. Send your new bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy result[0].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
