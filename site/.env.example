# Copy to .env for local development. On Vercel these go in
# Settings -> Environment Variables. Never commit real values.

# Cloudflare Turnstile — dash.cloudflare.com -> Turnstile -> Add site.
# PUBLIC_ is required: Astro only exposes PUBLIC_* to browser code.
# Left empty, both fall back to Cloudflare's always-passes test pair, but
# only in `astro dev`. Production refuses to send without the real secret.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Telegram delivery.
# 1. Message @BotFather -> /newbot -> copy the token here.
# 2. Send your new bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy result[0].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
